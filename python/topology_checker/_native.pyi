class NativeTopology:
    def __init__(self, tolerance: float) -> None: ...
    def add_layer(self, name: str, features: list[tuple[int, bytes]]) -> int: ...
    def add_rule(self, rule: str, layer: int, other: int | None = None) -> None: ...
    def register_rule(
        self, rule: str, inputs: list[tuple[int | None, str, list[tuple[int, bytes]]]]
    ) -> tuple[int, int | None]: ...
    def warnings(self) -> list[str]: ...
    def validate(self) -> str: ...

def registry() -> str: ...
def lines(geometries: list[bytes], tolerance: float | None = None) -> list[bytes]: ...
