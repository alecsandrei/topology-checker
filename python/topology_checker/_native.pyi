class NativeWarning:
    message: str
    layer: int | None
    fid: int | None
    part: int | None

class NativeViolation:
    @property
    def rule_index(self) -> int: ...
    @property
    def error_type(self) -> str: ...
    @property
    def wkb(self) -> bytes: ...
    @property
    def origin(self) -> tuple[int, int, int | None] | None: ...
    @property
    def destination(self) -> tuple[int, int, int | None] | None: ...

class NativeRuleSummary:
    @property
    def layer(self) -> int: ...
    @property
    def other(self) -> int | None: ...
    @property
    def counts(self) -> dict[str, int]: ...
    @property
    def total(self) -> int: ...

class NativeSummary:
    @property
    def tolerance(self) -> float: ...
    @property
    def warnings(self) -> list[NativeWarning]: ...
    @property
    def rules(self) -> list[NativeRuleSummary]: ...

class NativeReport:
    @property
    def summary(self) -> NativeSummary: ...
    @property
    def errors(self) -> list[NativeViolation]: ...

class NativeValidationStream:
    def next_batch(self) -> list[NativeViolation]: ...
    def close(self) -> None: ...
    @property
    def summary(self) -> NativeSummary | None: ...

class NativeTopology:
    def __init__(self, tolerance: float) -> None: ...
    def add_layer(self, name: str, features: list[tuple[int, bytes]]) -> int: ...
    def add_rule(self, rule: str, layer: int, other: int | None = None) -> None: ...
    def register_rule(
        self, rule: str, inputs: list[tuple[int | None, str, list[tuple[int, bytes]]]]
    ) -> tuple[int, int | None]: ...
    def warnings(self) -> list[NativeWarning]: ...
    def validate(self) -> NativeReport: ...
    def iter_validate(self, batch_size: int = 1024) -> NativeValidationStream: ...

def registry() -> str: ...
def lines(geometries: list[bytes], tolerance: float | None = None) -> list[bytes]: ...

class PrecisionError(RuntimeError):
    """Exact polygon topology could not be emitted with bounded coordinate rounding."""
