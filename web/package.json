{
  "name": "topology-checker-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "test:browser": "playwright test",
    "format": "prettier --write src tests e2e *.ts *.json index.html",
    "format:check": "prettier --check src tests e2e *.ts *.json index.html"
  },
  "dependencies": {
    "ol": "^10.6.1",
    "pinia": "^3.0.3",
    "reka-ui": "^2.5.0",
    "vue": "^3.5.21"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@tailwindcss/vite": "^4.1.13",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.18.6",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.0.8"
  }
}
